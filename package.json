{
  "name": "portal-gmac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "theme:build": "node scripts/build-dark-theme.mjs",
    "login-media": "node scripts/build-login-media.mjs",
    "login-logo": "node scripts/build-login-logo.mjs",
    "prebuild": "npm run theme:build",
    "dev": "concurrently --kill-others --names FRONTEND,BACKEND --prefix-colors cyan,green \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node server/index.js",
    "db:setup": "node scripts/setup-local-database.mjs",
    "db:optimize": "node scripts/optimize-sql.mjs",
    "check:smtp": "node scripts/check-smtp.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "pretest:browser": "npm run build",
    "test:browser": "node tests/admin-tools.browser.mjs",
    "pretest:payables": "npm run build",
    "test:payables": "node --test tests/payables.test.js && node tests/payables.browser.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^1.50.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
