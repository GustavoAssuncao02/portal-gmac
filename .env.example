PORT=3002
API_HOST=127.0.0.1
# Temporary test access without credentials. Only works with the API and the database on this computer (API_HOST and
# DB_HOST local) and never with NODE_ENV=production: a published portal always asks for the password.
TEST_LOGIN_ENABLED=false
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
DEMO_ADMIN_CPF=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=
SESSION_SECRET=

# Escopo da empresa na chave de idempotencia dos extratos OFX (empresa + banco + conta + FITID).
COMPANY_SCOPE=gmac


# Atualização semanal do catálogo fiscal (CNAE, NBS, NCM). Use "off" para desligar.
FISCAL_CATALOG_SYNC=on

# --- Hospedagem (SaveInCloud ou outro servidor) ---
# No servidor, use API_HOST=0.0.0.0 e NODE_ENV=production. Em produção, "npm start" gera a interface (dist/) quando ela estiver desatualizada.
# NODE_ENV=production

# Ambiente de teste na hospedagem, sem NODE_ENV=production: true gera a interface no start. Não libera o acesso sem senha
# (na hospedagem TEST_LOGIN_ENABLED é sempre ignorado); use um banco próprio para testes, nunca o da empresa.
BUILD_ON_START=false

# Pasta dos arquivos enviados (anexos, comprovantes, extratos OFX) e dos backups diários. Os dados ficam no MySQL. Vazio: server/data/.
# Na hospedagem, aponte para fora do código para o deploy do GitHub não apagar os dados (ex.: /home/jelastic/portal-data).
DATA_DIR=

# Proxies confiáveis à frente da aplicação (balanceador da hospedagem). "loopback" serve para uso local.
# Com um balanceador na frente, use 1; sem isso, todos os usuários dividem o mesmo IP no limite de requisições.
TRUST_PROXY=loopback

# Requisições por minuto, por IP, somadas entre todas as rotas da API.
API_RATE_LIMIT=200

# Tamanho máximo de cada anexo, em MB, e o espaço livre que o disco sempre guarda (um anexo que o ocuparia é recusado).
UPLOAD_MAX_MB=500
UPLOAD_DISK_RESERVE_MB=256

# Outros sites autorizados a chamar a API (separados por vírgula). Vazio: em produção, só o próprio portal.
CORS_ORIGIN=

# --- Orçamentos do site gmacmetalurgica.com.br (POST /gmac/api/quotes, envia e-mail ao comercial) ---
# Sites que podem enviar orçamentos: origens sem caminho e sem barra final, separadas por vírgula.
# Vazio: https://gmacmetalurgica.com.br e https://www.gmacmetalurgica.com.br. Para testar o site localmente, inclua http://localhost:5173.
QUOTES_ALLOWED_ORIGINS=
# Microsoft 365: STARTTLS na porta 587 (SMTP_SECURE=false). Sem SMTP_PASS os orçamentos ficam desligados e o portal sobe normalmente.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=comercial@gmacmetalurgica.com.br
# Preencha somente no servidor e no .env local. A conta precisa ter SMTP AUTH autorizado no Microsoft 365.
SMTP_PASS=
MAIL_FROM=comercial@gmacmetalurgica.com.br
